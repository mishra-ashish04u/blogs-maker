# Public — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — writes, automation, admin.
# Supabase Studio → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Free at https://aistudio.google.com/apikey — Gemini 1.5 Flash is free up to 1500 req/day
GEMINI_API_KEY=

# Jina Reader — https://jina.ai/reader  (free key from https://jina.ai)
# Used to fetch the full article body for a picked RSS headline, so Gemini
# writes grounded editorials from real source material instead of hallucinating.
# If unset, the pipeline falls back to the RSS snippet only.
JINA_API_KEY=

# Groq — free Llama 3.3 70B inference, preferred over Gemini Flash for
# editorial prose. Get a key at https://console.groq.com
# If both GROQ_API_KEY and GEMINI_API_KEY are set, Groq is used first and
# Gemini is the automatic fallback on any error.
GROQ_API_KEY=
# Optional: override the Groq model. Defaults to llama-3.3-70b-versatile.
# GROQ_MODEL=llama-3.3-70b-versatile
# Optional: force a specific provider (values: 'groq' | 'gemini').
# LLM_PROVIDER=groq

# Editorial passes. 1 = draft only (fast, free). 2 = draft + editor
# (the editor LLM reads the draft and rewrites weak sentences — bigger
# quality jump, still free, ~2 seconds extra).
EDITORIAL_PASSES=2
# Optional: route the editor to a different provider than the drafter
# for cross-model quality control. Values: 'groq' | 'gemini' | 'cross'.
# EDITOR_PROVIDER=cross

# Cover-image provider chain:
#   Gemini 2.5 Flash Image (Nano Banana, on-brand generated)
#   → Unsplash (real photography of everyday scenes)
#   → Pollinations (last-resort generated image)
# IMAGE_PROVIDER can force a starting point:
#   'pollinations' — skip Gemini and Unsplash
#   'unsplash'     — skip Gemini, start at Unsplash
# IMAGE_PROVIDER=pollinations
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Unsplash API — free demo tier (50 req/hour) is plenty for daily + topic
# runs. Get an access key at https://unsplash.com/developers (create an
# app; only the "Access Key" is needed, not the secret key).
UNSPLASH_ACCESS_KEY=

# Any random string — secures the /api/revalidate endpoint
REVALIDATE_SECRET=

# Used by the pipeline to ping revalidation after publishing
# (your live URL, e.g. https://dailyscamalert.com)
SITE_URL=

# ===== Admin login (/admin) =====
# REQUIRED in production. If missing, login returns 503.
# In development only, omitting these falls back to `admin` / `dev-password`
# with a loud console warning. DO NOT rely on the defaults in production.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Min 32 chars. Generate a real secret with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ===== GitHub Actions trigger (Run Now button) =====
# Required ONLY in production (Vercel can't spawn child processes).
# Locally, omitting these falls back to `tsx scripts/generate-daily-post.ts`.
#
# GITHUB_TOKEN: a fine-grained PAT with "Actions: Read and write" on this repo.
#   Create one at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Optional overrides — defaults shown.
# GITHUB_WORKFLOW=daily-blog.yml
# GITHUB_WORKFLOW_REF=main

# ===== Newsletter (Hostinger SMTP) =====
# Uses a standard SMTP mailbox — works with Hostinger, Zoho, Gmail-with-app-password,
# or any provider that speaks SMTP.
#
# Hostinger settings (default):
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
# Use port 587 instead if your network blocks 465 — then also set SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=465
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Optional display override. Format: "Display Name <address@your-domain.com>".
# If unset, emails are sent From: SMTP_USER.
NEWSLETTER_FROM=
# Optional reply-to address if different from the sender.
# NEWSLETTER_REPLY_TO=
